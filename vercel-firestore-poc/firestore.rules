rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /unidades/{docId} {
      allow read: if true;
      // Sem login (o GEC usa autenticação própria, não Firebase Auth), então
      // não dá pra restringir por usuário aqui. O mínimo pra não virar um
      // formulário aberto de spam: exige os campos certos e um nome curto.
      allow create: if request.resource.data.keys().hasAll(['nome', 'ativo'])
                    && request.resource.data.nome is string
                    && request.resource.data.nome.size() > 0
                    && request.resource.data.nome.size() < 200;
      allow update, delete: if false;
    }
  }
}
